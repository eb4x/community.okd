# vim: ft=nginx

server {
    listen 443 ssl http2 default;
    listen [::]:443 ssl http2 default;

    server_name {{ mirror_registry_fqdn }};

    ssl_certificate /etc/pki/tls/certs/{{ mirror_registry_fqdn }}.crt;
    ssl_certificate_key /etc/pki/tls/private/{{ mirror_registry_fqdn }}.key;

    location / {
        client_max_body_size 20G;

        #proxy_ssl_certificate /path/to/your/cert.crt;  # Optional: if your backend needs SSL client certs
        #proxy_ssl_certificate_key /path/to/your/cert.key;
        #proxy_ssl_verify off;  # Disable SSL verification (set to "on" if needed)

        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;

        proxy_pass https://127.0.0.1:8443;
    }
}

